{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dead-mans-switch",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DMS_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "vars": {
    "BASE_URL": "https://dead-mans-switch.example.workers.dev",
    "SENDER_EMAIL_ADDRESS": "noreply@yourdomain.com",
    "VAPID_SUBJECT": "mailto:owner@example.com",
    "OWNER_EMAIL_ADDRESS": "owner@example.com", // カンマ区切りで複数指定可能（例: "owner1@example.com, owner2@example.com"）
    "KIN_EMAIL_ADDRESS": "kin@example.com", // カンマ区切りで複数指定可能（例: "kin1@example.com, kin2@example.com"）
    "VAPID_PUBLIC_KEY": "YOUR_VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY": "YOUR_VAPID_PRIVATE_KEY",
    "WARNING_DAYS": "7",
    "DEAD_DAYS": "14",
    "WARNING_EMAIL_SUBJECT": "【重要】Dead Man's Switch 生存確認リマインダー",
    "WARNING_EMAIL_BODY": "生存シグナルが途絶えています。生存報告を行う場合は以下のURLを開いてください:\n${BASE_URL}/",
    "DEAD_EMAIL_SUBJECT": "【重要通知】手続情報およびメッセージのご案内",
    "DEAD_EMAIL_BODY": ""
  }
}
