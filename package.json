{
  "name": "dead-mans-switch",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "pnpm cf-typegen",
    "cf-typegen": "wrangler types --strict-vars=false --env-interface CloudflareBindings",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "cli": "tsx scripts/cli.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.0",
    "json5": "^2.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.8.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
